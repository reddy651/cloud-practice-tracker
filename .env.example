SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=mysql+mysqlconnector://practice_user:strong_password@localhost:3306/practice_tracker

# Azure
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=practice-reports

# For local development, DefaultAzureCredential can use `az login`.
# For Azure App Service, enable System Assigned Managed Identity and grant:
# - Reader on the subscription/resource group for Activity Log reads
# - Storage Blob Data Contributor on the storage account/container


# AI (OpenAI API; ChatGPT subscription and API billing are separate)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Object storage: azure, s3, or both
STORAGE_BACKEND=both

# AWS S3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-practice-tracker-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# Azure Activity Log collector (the VPS runs outside Azure, so use a service principal)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-secret
AZURE_ACTIVITY_POLL_SECONDS=300

# Public AI assistant / per-screenshot AI suggestions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
